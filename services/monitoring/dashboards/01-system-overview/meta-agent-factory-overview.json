          "expr": "(\n  (\n    avg(up{environment=\"$environment\",job=~\"meta-agent-.*\"}) * 0.3 +\n    (1 - avg(rate(http_request_errors_total{environment=\"$environment\"}[5m]) / rate(http_requests_total{environment=\"$environment\"}[5m]))) * 0.25 +\n    (1 - avg(cpu_usage_percent{environment=\"$environment\"}) / 100) * 0.2 +\n    (1 - avg(memory_usage_percent{environment=\"$environment\"}) / 100) * 0.15 +\n    avg(agent_coordination_success_rate{environment=\"$environment\"}) * 0.1\n  ) * 100\n)",
          "interval": "",
          "legendFormat": "System Health Score",
          "refId": "A"
        }
      ],
