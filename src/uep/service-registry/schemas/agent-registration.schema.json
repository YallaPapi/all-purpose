{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uep.example.com/schemas/agent-registration.schema.json",
  "title": "UEP Agent Registration Schema",
  "description": "JSON Schema for UEP Meta-Agent registration data model",
  "type": "object",
  "required": [
    "agentId",
    "agentName", 
    "agentType",
    "instanceId",
    "version",
    "capabilities",
    "supportedProtocols",
    "network",
    "resources",
    "currentMetrics",
    "healthCheck",
    "monitoring",
    "security",
    "environment",
    "cluster",
    "namespace",
    "startTime",
    "lastHeartbeat",
    "registrationTime",
    "status",
    "configuration",
    "featureFlags",
    "labels",
    "annotations"
  ],
  "additionalProperties": false,
  "properties": {
    "agentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Unique UUID v4 identifier for the agent"
    },
    "agentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-._]*[a-zA-Z0-9]$",
      "description": "Human-readable agent name"
    },
    "agentType": {
      "type": "string",
      "enum": [
        "prd-parser",
        "scaffold-generator", 
        "infra-orchestrator",
        "template-engine-factory",
        "all-purpose-pattern",
        "parameter-flow",
        "five-document-framework",
        "thirty-minute-rule",
        "vercel-native-architecture",
        "post-creation-investigator",
        "account-creation-system"
      ],
      "description": "Type of UEP meta-agent"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Unique instance identifier"
    },
    "version": {
      "type": "object",
      "required": ["major", "minor", "patch"],
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "minor": {
          "type": "integer", 
          "minimum": 0,
          "maximum": 999
        },
        "patch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "prerelease": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+$"
        },
        "build": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+$"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "buildDate": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceRequirements": {
            "$ref": "#/definitions/resourceRequirements"
          }
        }
      }
    },
    "supportedProtocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["UEP/2.0", "HTTP/1.1", "HTTP/2", "gRPC", "WebSocket"]
      }
    },
    "network": {
      "type": "object",
      "required": ["address", "port", "protocol", "tlsEnabled"],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "anyOf": [
            {"format": "ipv4"},
            {"format": "ipv6"},
            {"format": "hostname"}
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "additionalPorts": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9-]*$": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": ["http", "https", "grpc", "tcp"]
        },
        "tlsEnabled": {
          "type": "boolean"
        },
        "healthCheckPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/resourceRequirements"
    },
    "currentMetrics": {
      "type": "object",
      "required": ["currentLoad", "maxCapacity", "averageResponseTime", "errorRate", "queueLength", "lastUpdated"],
      "additionalProperties": false,
      "properties": {
        "currentLoad": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "averageResponseTime": {
          "type": "number",
          "minimum": 0
        },
        "errorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "queueLength": {
          "type": "integer",
          "minimum": 0
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "required": ["endpoint", "method", "interval", "timeout", "failureThreshold", "successThreshold"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9-._~!$&'()*+,;=:@/]*$"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST"]
        },
        "interval": {
          "type": "string",
          "pattern": "^\\d+[smh]$"
        },
        "timeout": {
          "type": "string", 
          "pattern": "^\\d+[smh]$"
        },
        "initialDelay": {
          "type": "string",
          "pattern": "^\\d+[smh]$"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "expectedResponse": {
          "type": "string"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["metricsEnabled", "metricsEndpoint", "metricsFormat", "tracingEnabled", "loggingLevel", "healthMetrics"],
      "additionalProperties": false,
      "properties": {
        "metricsEnabled": {
          "type": "boolean"
        },
        "metricsEndpoint": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9-._~!$&'()*+,;=:@/]*$"
        },
        "metricsFormat": {
          "type": "string",
          "enum": ["prometheus", "json", "statsd"]
        },
        "tracingEnabled": {
          "type": "boolean"
        },
        "tracingEndpoint": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9-._~!$&'()*+,;=:@/]*$"
        },
        "loggingLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "healthMetrics": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["tlsRequired", "encryptionEnabled", "auditLogging"],
      "additionalProperties": false,
      "properties": {
        "tlsRequired": {
          "type": "boolean"
        },
        "certificateFingerprint": {
          "type": "string",
          "pattern": "^[a-fA-F0-9:]{47,95}$"
        },
        "allowedClients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aclTokens": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "service": {
              "type": "string"
            }
          }
        },
        "encryptionEnabled": {
          "type": "boolean"
        },
        "auditLogging": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "cluster": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "podName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 253
    },
    "nodeName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 253
    },
    "startTime": {
      "type": "string",
      "format": "date-time"
    },
    "lastHeartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "registrationTime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["initializing", "healthy", "degraded", "unhealthy", "maintenance", "shutting-down", "unknown"]
    },
    "configuration": {
      "type": "object"
    },
    "featureFlags": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_]*$": {
          "type": "boolean"
        }
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(/[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$": {
          "type": "string",
          "maxLength": 63
        }
      }
    },
    "annotations": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(/[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "resourceRequirements": {
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "object",
          "required": ["min", "max", "preferred"],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^\\d+m?$"
            },
            "max": {
              "type": "string",
              "pattern": "^\\d+m?$"
            },
            "preferred": {
              "type": "string",
              "pattern": "^\\d+m?$"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": ["min", "max", "preferred"],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^\\d+([KMGT]i?)?$"
            },
            "max": {
              "type": "string",
              "pattern": "^\\d+([KMGT]i?)?$"
            },
            "preferred": {
              "type": "string",
              "pattern": "^\\d+([KMGT]i?)?$"
            }
          }
        },
        "storage": {
          "type": "object",
          "required": ["temporary"],
          "additionalProperties": false,
          "properties": {
            "temporary": {
              "type": "string",
              "pattern": "^\\d+([KMGT]i?)?$"
            },
            "persistent": {
              "type": "string",
              "pattern": "^\\d+([KMGT]i?)?$"
            }
          }
        },
        "gpu": {
          "type": "object",
          "required": ["required"],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": ["nvidia.com/gpu", "amd.com/gpu"]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}