{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/main-simple.ts",
    "src/core/SimplePostCreationInvestigator.ts",
    "src/types/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/main.ts",
    "src/core/PostCreationInvestigator.ts"
  ]
}