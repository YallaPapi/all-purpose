## Usage

### Programmatic Usage

```javascript
const { {{pascalCase agentName}}Agent } = require('./main');

async function example() {
  const agent = new {{pascalCase agentName}}Agent({
    logLevel: 'info',
    timeout: 30000
  });
  
  await agent.initialize();
  const result = await agent.process({ 
    // Your input data here
  });
  
  console.log('Result:', result);
  await agent.cleanup();
