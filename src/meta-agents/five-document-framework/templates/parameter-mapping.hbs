### Default Environment Configuration

```typescript
// Environment-agnostic parameter handling
const getEnvironmentConfig = () => {
  const env = process.env.NODE_ENV || 'development';
  
  return {
    environment: env,
    
    // Database config (if applicable)
    {{#if project.technologies.database}}
    database: {
      url: process.env.DATABASE_URL || 'default_connection',
      options: parseConnectionString(process.env.DATABASE_URL)
    },
    {{/if}}
    
    // API configurations (dynamic)
    apis: Object.keys(process.env)
      .filter(key => key.endsWith('_API_KEY'))
      .reduce((acc, key) => {
        const serviceName = key.replace('_API_KEY', '');
        acc[serviceName] = {
          apiKey: process.env[key],
          baseUrl: process.env[`${serviceName}_BASE_URL`]
        };
        return acc;
      }, {} as Record<string, any>),
    
    // All-Purpose Pattern: UNLIMITED environment variables
    custom: Object.keys(process.env)
      .filter(key => key.startsWith('CUSTOM_'))
      .reduce((acc, key) => {
        acc[key] = process.env[key];
        return acc;
      }, {} as Record<string, string>)
  };
};
