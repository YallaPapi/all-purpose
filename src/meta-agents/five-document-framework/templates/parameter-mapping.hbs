// All-Purpose Pattern: Validation without limitations
interface ValidationRule {
  field?: string; // Optional - validates all fields if omitted
  type?: 'string' | 'number' | 'boolean' | 'object' | 'array' | 'any';
  required?: boolean;
  min?: number;
  max?: number; // Use sparingly - avoid hardcoded limits
  pattern?: RegExp;
  custom?: (value: any) => boolean | string;
