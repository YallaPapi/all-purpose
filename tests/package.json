{
  "name": "all-purpose-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for the All-Purpose Meta-Agent Factory",
  "main": "index.js",
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:e2e": "jest e2e/ --testTimeout=30000",
    "test:integration": "jest integration/",
    "test:unit": "jest unit/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:agent-simulator": "node e2e/test-agent-simulator.js",
    "test:multi-agents": "node e2e/run-multi-agent-simulation.js"
  },
  "dependencies": {
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}