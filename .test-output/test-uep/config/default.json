{
  "test-uep": {
    "enabled": true,
    "name": "Test UEP",
    "description": "A test agent to verify UEP integration",
    "version": "1.0.0",
    "logLevel": "info",
    "timeout": 30000,
    "retries": 3,
    "retryDelay": 1000
  },
  "environment": {
    "nodeEnv": "development",
    "debugMode": false,
    "verboseLogging": false
  },
  "performance": {
    "maxConcurrency": 10,
    "batchSize": 100,
    "memoryLimit": "512MB"
  },
  "monitoring": {
    "enableMetrics": true,
    "metricsInterval": 60000,
    "enableHealthCheck": true,
    "healthCheckPort": 3001
  },
  "tasks": {
    "defaultPriority": "medium",
    "maxTasksPerRun": 1000,
    "taskTimeout": 300000
  }
}