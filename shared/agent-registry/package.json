{
  "name": "@all-purpose/agent-registry",
  "version": "1.0.0",
  "description": "Standardized agent registration framework for service discovery and coordination",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
