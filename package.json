{
  "name": "meta-agent-factory",
  "version": "1.0.0",
  "description": "All-Purpose Meta-Agent Factory - Takes PRDs and generates working software",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "next build",
    "build:factory": "tsc -p tsconfig.json",
    "build:agents": "npm run build --workspaces",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ apps/ packages/ --ext .js,.ts,.tsx",
    "lint:fix": "eslint src/ apps/ packages/ --ext .js,.ts,.tsx --fix",
    "start": "next start -p ${PORT:-3000}",
    "dev": "next dev",
    "dev:factory": "node src/autonomous-factory.js",
    "clean": "rimraf dist node_modules/.cache",
    "clean:all": "npm run clean && npm run clean --workspaces",
    "install:all": "npm install && npm install --workspaces",
    "docker:build": "docker build -t meta-agent-factory .",
    "docker:run": "docker run -p 8080:8080 meta-agent-factory",
    "docker:build:all": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans && docker system prune -f",
    "mvs:start": "docker-compose up -d api-gateway factory-core domain-agents uep-service nats-broker observability",
    "mvs:stop": "docker-compose down",
    "mvs:status": "docker-compose ps",
    "microservices:start": "docker-compose -f docker-compose-microservices.yml up -d",
    "microservices:stop": "docker-compose -f docker-compose-microservices.yml down",
    "microservices:status": "docker-compose -f docker-compose-microservices.yml ps",
    "microservices:logs": "docker-compose -f docker-compose-microservices.yml logs -f",
    "microservices:build": "docker-compose -f docker-compose-microservices.yml build",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "istio:install": "kubectl apply -f k8s/istio/",
    "health": "curl -f http://localhost:8080/health || exit 1"
  },
  "workspaces": [
    "apps/*",
    "packages/meta-agents/*",
    "packages/rag-system"
  ],
  "keywords": [
    "meta-agent",
    "factory",
    "prd",
    "software-generation",
    "ai",
    "automation"
  ],
  "author": "Stuart Oden",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.2",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.48.0",
    "@opentelemetry/resources": "^1.21.0",
    "@opentelemetry/sdk-node": "^0.48.0",
    "@opentelemetry/semantic-conventions": "^1.21.0",
    "@types/node": "^24.1.0",
    "@upstash/redis": "^1.35.1",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "handlebars": "^4.7.8",
    "ioredis": "^5.5.1",
    "mustache": "^4.2.0",
    "next": "14.2.5",
    "node-fetch": "^2.7.0",
    "openai": "^4.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "yaml": "^2.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/mustache": "^4.2.5",
    "@types/react": "19.1.8",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testEnvironment": "node",
    "moduleNameMapping": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "packages/**/*.{js,ts}",
      "!src/**/*.test.{js,ts}",
      "!src/**/*.spec.{js,ts}"
    ],
    "testMatch": [
      "**/__tests__/**/*.(js|ts)",
      "**/?(*.)(test|spec).(js|ts)"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YallaPapi/all-purpose.git"
  },
  "bugs": {
    "url": "https://github.com/YallaPapi/all-purpose/issues"
  },
  "homepage": "https://github.com/YallaPapi/all-purpose#readme"
}
