{
  "streams": [
    {
      "name": "UEP_PROTOCOL_MESSAGES",
      "description": "Primary stream for all UEP protocol validated messages",
      "subjects": [
        "UEP.v1.0.>",
        "UEP.v1.1.>", 
        "UEP.v2.0.>",
        "UEP.v2.1.>"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 500000,
      "max_bytes": 5368709120,
      "max_age": 7776000000000000,
      "storage": "file",
      "replicas": 3,
      "discard": "old",
      "duplicate_window": 300000000000,
      "compression": "s2",
      "metadata": {
        "purpose": "UEP protocol message bus",
        "compliance": "UEP-2.1-compliant",
        "validation": "mandatory"
      }
    },
    {
      "name": "UEP_META_AGENT_COORDINATION",
      "description": "Stream for meta-agent coordination using UEP protocol",
      "subjects": [
        "UEP.v*.meta.factory.*",
        "UEP.v*.meta.scaffold.*",
        "UEP.v*.meta.parameter-flow.*",
        "UEP.v*.meta.investigation.*",
        "UEP.v*.meta.template-engine.*",
        "UEP.v*.meta.thirty-minute.*",
        "UEP.v*.meta.five-document.*",
        "UEP.v*.meta.vercel-architecture.*",
        "UEP.v*.meta.account-creation.*",
        "UEP.v*.meta.all-purpose-pattern.*",
        "UEP.v*.meta.post-creation.*"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 250000,
      "max_bytes": 2684354560,
      "max_age": 5184000000000000,
      "storage": "file",
      "replicas": 3,
      "discard": "old",
      "duplicate_window": 180000000000,
      "compression": "s2"
    },
    {
      "name": "UEP_DOMAIN_AGENT_COORDINATION", 
      "description": "Stream for domain agent coordination using UEP protocol",
      "subjects": [
        "UEP.v*.domain.backend.*",
        "UEP.v*.domain.frontend.*",
        "UEP.v*.domain.devops.*",
        "UEP.v*.domain.qa.*",
        "UEP.v*.domain.documentation.*"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 200000,
      "max_bytes": 2147483648,
      "max_age": 3888000000000000,
      "storage": "file",
      "replicas": 3,
      "discard": "old",
      "duplicate_window": 120000000000,
      "compression": "s2"
    },
    {
      "name": "UEP_VALIDATION_AUDIT",
      "description": "Audit trail for UEP protocol validation events",
      "subjects": [
        "audit.validation.success.*",
        "audit.validation.failure.*",
        "audit.transformation.*",
        "audit.circuit-breaker.*",
        "audit.version-negotiation.*"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 1000000,
      "max_bytes": 1073741824,
      "max_age": 15552000000000000,
      "storage": "file",
      "replicas": 3,
      "discard": "old",
      "duplicate_window": 600000000000
    },
    {
      "name": "UEP_FACTORY_ORCHESTRATION",
      "description": "Factory-level orchestration using UEP protocol",
      "subjects": [
        "UEP.v*.factory.task.assigned",
        "UEP.v*.factory.task.progress",
        "UEP.v*.factory.task.completed",
        "UEP.v*.factory.workflow.started",
        "UEP.v*.factory.workflow.completed",
        "UEP.v*.factory.coordination.*",
        "UEP.v*.factory.error.reported"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 100000,
      "max_bytes": 1073741824,
      "max_age": 2592000000000000,
      "storage": "file",
      "replicas": 3,
      "discard": "old",
      "duplicate_window": 240000000000
    },
    {
      "name": "UEP_PERFORMANCE_METRICS",
      "description": "UEP protocol performance and system metrics",
      "subjects": [
        "metrics.uep.version.usage.*",
        "metrics.uep.validation.latency.*",
        "metrics.uep.transformation.performance.*",
        "metrics.uep.circuit-breaker.*",
        "metrics.uep.negotiation.*",
        "metrics.system.health.*",
        "metrics.agent.performance.*",
        "alerts.uep.*"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 50000,
      "max_bytes": 536870912,
      "max_age": 1209600000000000,
      "storage": "memory",
      "replicas": 1,
      "discard": "old",
      "max_msg_size": 65536
    },
    {
      "name": "UEP_CIRCUIT_BREAKER_EVENTS",
      "description": "Circuit breaker state changes and fallback events",
      "subjects": [
        "circuit-breaker.state.changed.*",
        "circuit-breaker.fallback.triggered.*",
        "circuit-breaker.recovery.*",
        "version.fallback.used.*"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 25000,
      "max_bytes": 268435456,
      "max_age": 604800000000000,
      "storage": "file",
      "replicas": 2,
      "discard": "old"
    },
    {
      "name": "LEGACY_META_AGENT_EVENTS",
      "description": "Legacy stream for non-UEP meta-agent events (backward compatibility)",
      "subjects": [
        "meta.agent.created",
        "meta.agent.started",
        "meta.agent.completed",
        "meta.agent.failed",
        "meta.agent.deleted"
      ],
      "retention": "limits",
      "max_consumers": -1,
      "max_msgs": 50000,
      "max_bytes": 536870912,
      "max_age": 1296000000000000,
      "storage": "file",
      "replicas": 1,
      "discard": "old"
    }
  ],
  "consumers": [
    {
      "stream_name": "UEP_PROTOCOL_MESSAGES",
      "name": "uep-validation-consumer",
      "description": "UEP protocol validation service consumer",
      "durable_name": "uep-validation",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 5000000000,
      "max_deliver": 1,
      "filter_subject": "UEP.>",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 1000
    },
    {
      "stream_name": "UEP_META_AGENT_COORDINATION",
      "name": "factory-core-consumer",
      "description": "Factory core service consumer for UEP meta-agent coordination",
      "durable_name": "factory-core-uep",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 3,
      "filter_subject": "UEP.v*.meta.factory.*",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 500
    },
    {
      "stream_name": "UEP_META_AGENT_COORDINATION",
      "name": "meta-agent-orchestrator",
      "description": "Meta-agent orchestrator for coordination",
      "durable_name": "meta-orchestrator",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 60000000000,
      "max_deliver": 5,
      "filter_subject": "UEP.v*.meta.*",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 1000
    },
    {
      "stream_name": "UEP_DOMAIN_AGENT_COORDINATION", 
      "name": "domain-coordination-consumer",
      "description": "Cross-domain coordination consumer using UEP protocol",
      "durable_name": "domain-coordination-uep",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 3,
      "filter_subject": "UEP.v*.domain.*",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 500
    },
    {
      "stream_name": "UEP_FACTORY_ORCHESTRATION",
      "name": "factory-orchestrator-consumer",
      "description": "Factory orchestration consumer using UEP protocol",
      "durable_name": "factory-orchestrator-uep",
      "deliver_policy": "all",
      "ack_policy": "explicit", 
      "ack_wait": 60000000000,
      "max_deliver": 5,
      "filter_subject": "UEP.v*.factory.*",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 250
    },
    {
      "stream_name": "UEP_VALIDATION_AUDIT",
      "name": "audit-trail-consumer",
      "description": "Audit trail consumer for UEP validation events",
      "durable_name": "audit-trail",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 120000000000,
      "max_deliver": 1,
      "filter_subject": "audit.*",
      "replay_policy": "instant",
      "flow_control": false,
      "max_ack_pending": 10000
    },
    {
      "stream_name": "UEP_PERFORMANCE_METRICS",
      "name": "observability-consumer",
      "description": "Observability system consumer for UEP metrics",
      "durable_name": "observability-uep",
      "deliver_policy": "last_per_subject",
      "ack_policy": "explicit",
      "ack_wait": 10000000000,
      "max_deliver": 1,
      "filter_subject": "metrics.uep.*",
      "replay_policy": "instant",
      "flow_control": false,
      "max_ack_pending": 100
    },
    {
      "stream_name": "UEP_PERFORMANCE_METRICS",
      "name": "prometheus-metrics-consumer",
      "description": "Prometheus metrics exporter consumer",
      "durable_name": "prometheus-metrics",
      "deliver_policy": "last_per_subject",
      "ack_policy": "none",
      "filter_subject": "metrics.>",
      "replay_policy": "instant",
      "flow_control": false,
      "max_ack_pending": 50
    },
    {
      "stream_name": "UEP_CIRCUIT_BREAKER_EVENTS",
      "name": "circuit-breaker-monitor",
      "description": "Circuit breaker event monitoring consumer",
      "durable_name": "circuit-breaker-monitor",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 15000000000,
      "max_deliver": 2,
      "filter_subject": "circuit-breaker.*",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 100
    },
    {
      "stream_name": "UEP_PROTOCOL_MESSAGES",
      "name": "version-negotiation-consumer",
      "description": "Version negotiation and compatibility monitoring",
      "durable_name": "version-negotiation",
      "deliver_policy": "new",
      "ack_policy": "explicit",
      "ack_wait": 5000000000,
      "max_deliver": 1,
      "filter_subject": "UEP.>",
      "replay_policy": "instant",
      "flow_control": true,
      "max_ack_pending": 200,
      "sample_freq": "10%"
    },
    {
      "stream_name": "LEGACY_META_AGENT_EVENTS",
      "name": "legacy-compatibility-consumer",
      "description": "Legacy system backward compatibility consumer",
      "durable_name": "legacy-compatibility",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 3,
      "filter_subject": "meta.agent.*",
      "replay_policy": "instant",
      "flow_control": false,
      "max_ack_pending": 100
    }
  ]
}