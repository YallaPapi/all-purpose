# Test Agent Dockerfile
# Task 191.4: Test agent for validating service discovery

FROM node:18-alpine

LABEL maintainer="UEP Team"
LABEL version="1.0.0"
LABEL description="Service Discovery Test Agent"

# Install system dependencies
RUN apk add --no-cache \
    curl \
    wget \
    dumb-init \
    && rm -rf /var/cache/apk/*

# Create app user
RUN addgroup -g 1001 -S appuser && \
    adduser -S -D -H -u 1001 -s /sbin/nologin -G appuser appuser

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci --only=production && \
    npm cache clean --force

# Copy application code
COPY . .
COPY examples/basic-agent-example.ts ./test-agent.ts

# Build TypeScript
RUN npm run build

# Create necessary directories
RUN mkdir -p /app/logs /app/data && \
    chown -R appuser:appuser /app

# Expose port
EXPOSE 3099

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3099/health || exit 1

# Switch to app user
USER appuser

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start the test agent
CMD ["node", "dist/test-agent.js"]