# =============================================================================
# UEP Meta-Agent Factory - Base Agent Dockerfile Template
# =============================================================================
# 
# This is the foundational Dockerfile template for all UEP agents, incorporating
# container security best practices, multi-stage builds, and production-ready
# optimizations.
#
# Template Version: 1.0.0
# Base Image: Node.js 20 Alpine (LTS)
# Security Level: Hardened
# Build Strategy: Multi-stage with layer caching optimization
#
# Usage:
#   1. Copy this template to your agent directory
#   2. Customize the AGENT_TYPE, AGENT_NAME, and dependencies
#   3. Build with: docker build --target production -t agent-name .
#
# =============================================================================

# Enable BuildKit features for enhanced build performance
# syntax=docker/dockerfile:1.7-labs

# =============================================================================
# Build Arguments (Customizable per agent)
# =============================================================================
ARG NODE_VERSION=20.11.1
ARG ALPINE_VERSION=alpine3.19
ARG AGENT_TYPE=base-agent
ARG AGENT_NAME="UEP Base Agent"
ARG AGENT_VERSION=1.0.0
ARG BUILD_DATE
ARG GIT_COMMIT
ARG BUILD_NUMBER

# =============================================================================
# Stage 1: Base Environment Setup
# =============================================================================
FROM node:${NODE_VERSION}-${ALPINE_VERSION} AS base

# Install system dependencies and security updates
RUN apk update && apk upgrade && \
    apk add --no-cache \
        dumb-init \
        tini \
        curl \
        ca-certificates \
        tzdata && \
    # Remove package manager cache
    rm -rf /var/cache/apk/* && \
    # Create non-root user for security
    addgroup -g 1000 -S agent && \
    adduser -u 1000 -S -G agent -h /app -s /sbin/nologin agent && \
    # Set up secure directories
    mkdir -p /app /app/logs /app/tmp /app/config && \
    chown -R agent:agent /app

# Set working directory
WORKDIR /app

# Configure environment variables
ENV NODE_ENV=production \
    NPM_CONFIG_CACHE=/tmp/.npm \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    AGENT_USER=agent \
    AGENT_UID=1000 \
    AGENT_GID=1000

# =============================================================================
# Stage 2: Dependency Installation
# =============================================================================
FROM base AS dependencies

# Switch to agent user for dependency installation
USER agent

# Copy package files with proper ownership
COPY --chown=agent:agent package*.json ./

# Install production dependencies with optimizations
RUN npm ci --only=production --silent --no-progress && \
    # Clean npm cache
    npm cache clean --force && \
    # Remove unnecessary files
    find node_modules -name "*.md" -delete && \
    find node_modules -name "test" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find node_modules -name "tests" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find node_modules -name "*.test.js" -delete && \
    find node_modules -name "*.spec.js" -delete

# =============================================================================
# Stage 3: Development Build (for debugging and testing)
# =============================================================================
FROM dependencies AS development

# Override environment for development
ENV NODE_ENV=development \
    LOG_LEVEL=debug \
    ENABLE_DEBUG=true

# Install development dependencies
RUN npm ci --silent --no-progress

# Copy source code
COPY --chown=agent:agent . .

# Create development startup script
RUN echo '#!/bin/sh' > /app/start-dev.sh && \
    echo 'set -e' >> /app/start-dev.sh && \
    echo 'echo "Starting agent in development mode..."' >> /app/start-dev.sh && \
    echo 'exec node --inspect=0.0.0.0:9229 src/index.js "$@"' >> /app/start-dev.sh && \
    chmod +x /app/start-dev.sh

# Expose development debugging port
EXPOSE 9229

# Development startup command
CMD ["/app/start-dev.sh"]

# =============================================================================
# Stage 4: Production Build
# =============================================================================
FROM dependencies AS production

# Copy source code with proper ownership
COPY --chown=agent:agent src/ ./src/
COPY --chown=agent:agent config/ ./config/ 2>/dev/null || true
COPY --chown=agent:agent public/ ./public/ 2>/dev/null || true
COPY --chown=agent:agent scripts/ ./scripts/ 2>/dev/null || true

# Create production startup script with proper signal handling
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Signal handling for graceful shutdown' >> /app/start.sh && \
    echo 'shutdown() {' >> /app/start.sh && \
    echo '  echo "Received shutdown signal, gracefully stopping..."' >> /app/start.sh && \
    echo '  kill -TERM "$child" 2>/dev/null' >> /app/start.sh && \
    echo '  wait "$child"' >> /app/start.sh && \
    echo '  echo "Agent stopped gracefully"' >> /app/start.sh && \
    echo '  exit 0' >> /app/start.sh && \
    echo '}' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Set up signal traps' >> /app/start.sh && \
    echo 'trap shutdown SIGTERM SIGINT' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Start the agent with proper signal forwarding' >> /app/start.sh && \
    echo 'echo "Starting ${AGENT_NAME} (${AGENT_TYPE} v${AGENT_VERSION})"' >> /app/start.sh && \
    echo 'echo "Environment: ${NODE_ENV}"' >> /app/start.sh && \
    echo 'echo "Process ID: $$"' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo 'node src/index.js "$@" &' >> /app/start.sh && \
    echo 'child=$!' >> /app/start.sh && \
    echo 'wait "$child"' >> /app/start.sh && \
    chmod +x /app/start.sh

# Create health check script
RUN echo '#!/bin/sh' > /app/health-check.sh && \
    echo 'set -e' >> /app/health-check.sh && \
    echo '' >> /app/health-check.sh && \
    echo '# Health check endpoint' >> /app/health-check.sh && \
    echo 'HEALTH_URL="http://localhost:${SERVICE_PORT:-3000}/health"' >> /app/health-check.sh && \
    echo '' >> /app/health-check.sh && \
    echo '# Perform health check with timeout' >> /app/health-check.sh && \
    echo 'curl -f --max-time 5 --silent "$HEALTH_URL" > /dev/null || {' >> /app/health-check.sh && \
    echo '  echo "Health check failed for $HEALTH_URL"' >> /app/health-check.sh && \
    echo '  exit 1' >> /app/health-check.sh && \
    echo '}' >> /app/health-check.sh && \
    echo '' >> /app/health-check.sh && \
    echo 'echo "Health check passed"' >> /app/health-check.sh && \
    chmod +x /app/health-check.sh

# Set secure file permissions
RUN find /app -type f -exec chmod 644 {} + && \
    find /app -type d -exec chmod 755 {} + && \
    chmod +x /app/start.sh /app/health-check.sh

# =============================================================================
# Final Stage Configuration
# =============================================================================

# Define build and runtime labels (OCI compliant)
LABEL org.opencontainers.image.title="${AGENT_NAME}" \
      org.opencontainers.image.description="UEP Meta-Agent Factory ${AGENT_TYPE}" \
      org.opencontainers.image.version="${AGENT_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.vendor="UEP Meta-Agent Factory" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/uep-factory/meta-agents" \
      \
      # UEP-specific labels
      uep.agent.type="${AGENT_TYPE}" \
      uep.agent.name="${AGENT_NAME}" \
      uep.agent.version="${AGENT_VERSION}" \
      uep.build.number="${BUILD_NUMBER}" \
      uep.security.user="agent:1000" \
      uep.template.version="1.0.0"

# Define runtime environment variables
ENV AGENT_TYPE=${AGENT_TYPE} \
    AGENT_NAME=${AGENT_NAME} \
    AGENT_VERSION=${AGENT_VERSION} \
    SERVICE_PORT=3000 \
    HEALTH_CHECK_PORT=3000 \
    HEALTH_CHECK_PATH=/health \
    METRICS_PORT=3000 \
    METRICS_PATH=/metrics \
    LOG_LEVEL=info \
    SHUTDOWN_TIMEOUT=30000 \
    STARTUP_TIMEOUT=60000

# Expose default ports
EXPOSE ${SERVICE_PORT} ${HEALTH_CHECK_PORT} ${METRICS_PORT}

# Configure health check with reasonable intervals
HEALTHCHECK --interval=30s \
            --timeout=10s \
            --start-period=60s \
            --retries=3 \
            CMD ["/app/health-check.sh"]

# Set resource limits (can be overridden in docker-compose or k8s)
# These are recommendations that can be customized per agent type
ENV MEMORY_LIMIT=512M \
    CPU_LIMIT=1000m \
    CPU_REQUEST=250m \
    MEMORY_REQUEST=256M

# Switch to non-root user for security
USER agent

# Set up proper working directory
WORKDIR /app

# Configure volume mount points for persistent data
VOLUME ["/app/logs", "/app/data", "/app/tmp"]

# Initialize with tini for proper process handling
ENTRYPOINT ["/sbin/tini", "--"]

# Default startup command (can be overridden)
CMD ["/app/start.sh"]

# =============================================================================
# Build Instructions and Usage Examples
# =============================================================================
#
# Development Build:
#   docker build --target development --tag agent-dev .
#   docker run -p 3000:3000 -p 9229:9229 -e NODE_ENV=development agent-dev
#
# Production Build:
#   docker build --target production \
#     --build-arg AGENT_TYPE=my-agent \
#     --build-arg AGENT_NAME="My Custom Agent" \
#     --build-arg BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ') \
#     --build-arg GIT_COMMIT=$(git rev-parse HEAD) \
#     --tag my-agent:latest .
#
# Running with custom configuration:
#   docker run -d \
#     --name my-agent \
#     -p 3000:3000 \
#     -e SERVICE_PORT=3000 \
#     -e LOG_LEVEL=info \
#     -e NODE_ENV=production \
#     -v agent-logs:/app/logs \
#     -v agent-data:/app/data \
#     --restart unless-stopped \
#     my-agent:latest
#
# Security scanning:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
#     -v $HOME/Library/Caches:/root/.cache/ \
#     aquasec/trivy image my-agent:latest
#
# =============================================================================