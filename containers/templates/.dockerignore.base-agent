# =============================================================================
# UEP Meta-Agent Factory - Base Agent .dockerignore Template
# =============================================================================
#
# This file specifies what files and directories should be excluded from the
# Docker build context to optimize build performance and reduce image size.
#
# Template Version: 1.0.0
# Optimized for: Node.js applications with TypeScript support
#
# Usage:
#   1. Copy this file to your agent directory as ".dockerignore"
#   2. Customize the exclusions based on your specific agent requirements
#   3. Ensure sensitive files are properly excluded
#
# =============================================================================

# =============================================================================
# Version Control and Git
# =============================================================================
.git
.gitignore
.gitkeep
.gitattributes
.gitmodules
**/.git
**/.gitignore

# =============================================================================
# Build and Distribution
# =============================================================================
dist/
build/
out/
target/
**/*.tgz
**/*.tar.gz
**/*.zip
*.tar
*.gz

# =============================================================================
# Dependencies and Package Managers
# =============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
package-lock.json
.pnpm-debug.log*
.npmignore
.yarnrc
.yarnrc.yml
.yarn/
.pnp.*

# =============================================================================
# Development and Testing
# =============================================================================
# Test files and directories
test/
tests/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
__tests__/
__mocks__/
coverage/
.nyc_output/
.coverage/
jest.config.*
vitest.config.*
playwright.config.*

# Development tools
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# TypeScript and JavaScript
# =============================================================================
# TypeScript build cache
*.tsbuildinfo
.tscache/

# ESLint and Prettier
.eslintrc.*
.eslintignore
.prettierrc.*
.prettierignore
.stylelintrc.*

# Babel
.babelrc
.babelrc.*
babel.config.*

# =============================================================================
# Environment and Configuration Files
# =============================================================================
# Environment files (CRITICAL: Never include in production images)
.env
.env.*
.environment
**/.env
**/.env.*

