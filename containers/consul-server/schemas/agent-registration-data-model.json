            },
            "apiSpec": {
              "type": "string",
              "format": "uri", 
              "description": "URL to OpenAPI/Swagger specification"
            }
          }
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for organization and filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional annotations for external tools"
