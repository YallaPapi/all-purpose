FROM node:20-alpine

WORKDIR /app

# Create package.json inline
RUN echo '{"name":"domain-agents","version":"1.0.0","main":"simple-server.js","dependencies":{"express":"^4.18.2"}}' > package.json

# Install dependencies
RUN npm install

# Copy server file
COPY src/simple-server.js .

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -q -O - http://localhost:3001/health || exit 1

CMD ["node", "simple-server.js"]