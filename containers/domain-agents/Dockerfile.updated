FROM node:18-alpine

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm install

# Copy domain agents source code
COPY src/ ./src/

# Copy the actual domain agent implementations from generated folder
COPY ../../generated/backend-agent ./generated/backend-agent
COPY ../../generated/frontend-agent ./generated/frontend-agent
COPY ../../generated/devops-agent ./generated/devops-agent
COPY ../../generated/qa-agent ./generated/qa-agent
COPY ../../generated/documentation-agent ./generated/documentation-agent

# Copy utilities and shared code
COPY ../shared/utils ./src/utils
COPY ../shared/services ./src/services

# Create necessary directories
RUN mkdir -p logs

# Set environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:3001/health || exit 1

# Run with tsx for TypeScript support
CMD ["npx", "tsx", "src/domain-agents.ts"]