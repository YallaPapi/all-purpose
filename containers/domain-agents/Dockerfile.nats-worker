FROM node:20-alpine

LABEL maintainer="meta-agent-factory"
LABEL description="NATS-Only Domain Agent Worker - No HTTP Endpoints"

# Install necessary packages including curl for health checks
RUN apk add --no-cache git python3 make g++ curl procps

WORKDIR /app

# Copy package files first
COPY package*.json ./

# Install all dependencies 
RUN npm install

# Copy all source files
COPY . .

# Build TypeScript to JavaScript
RUN npm run build

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/health-checks

# Copy health check scripts
COPY src/nats-health-check.js /app/health-checks/
COPY src/health-checks/ /app/health-checks/

# Make shell scripts executable
RUN chmod +x /app/health-checks/*.sh

# Set environment variables
ENV NODE_ENV=production
ENV NATS_URL=nats://nats-broker:4222
ENV FACTORY_CORE_URL=http://factory-core:3000
ENV UEP_REGISTRY_URL=http://uep-registry:3001
ENV DOCKER_CONTAINER=true
ENV AGENT_TYPE=backend

# Set proper permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S agents -u 1001 && \
    chown -R agents:nodejs /app

USER agents

# No exposed ports - this is a pure NATS worker

# Health check specifically for NATS connectivity
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node /app/health-checks/nats-health-check.js || exit 1

# Run NATS-only worker (no HTTP server)
CMD ["node", "dist/simple-domain-agent.js"]