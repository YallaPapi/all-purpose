FROM node:20-alpine

WORKDIR /app

# Create package.json inline
RUN echo '{"name":"uep-service","version":"1.0.0","main":"simple-uep.js","dependencies":{"express":"^4.18.2"}}' > package.json

# Install dependencies
RUN npm install

# Copy server file
COPY src/simple-uep.js .

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -q -O - http://localhost:3002/health || exit 1

CMD ["node", "simple-uep.js"]