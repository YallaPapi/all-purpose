FROM grafana/promtail:2.9.0
LABEL maintainer="meta-agent-factory"
LABEL description="Promtail log collector for Meta-Agent Factory MVS Architecture"

# Copy custom configuration
COPY promtail.yml /etc/promtail/promtail.yml

# Create positions directory
RUN mkdir -p /tmp && chown -R 10001:10001 /tmp

# Expose Promtail port
EXPOSE 9080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9080/ready || exit 1

CMD ["-config.file=/etc/promtail/promtail.yml"]