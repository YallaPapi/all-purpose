    {{ if eq .GroupLabels.service "uep-service" }}"Validate UEP protocol compliance and validation",{{ end }}
    "Consider service restart if issue persists"
  ],
  "escalation_policy": "Critical alerts auto-escalate after 15 minutes if not acknowledged",
  "alertmanager_url": "http://localhost:9093",
  "dashboard_url": "http://localhost:3004/d/meta-agent-overview",
  "service_dashboard_url": "http://localhost:3004/d/service-{{ .GroupLabels.service }}",
  "logs_url": "http://localhost:3004/explore?left=%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22expr%22%3A%22%7Bservice%3D%5C%22{{ .GroupLabels.service }}%5C%22%7D%22%7D%5D%7D",
  {{ if .CommonAnnotations.runbook_url }}"runbook_url": "{{ .CommonAnnotations.runbook_url }}",{{ end }}
  "on_call_contact": "Platform Team via PagerDuty",
  "generator_url": "{{ (index .Alerts 0).GeneratorURL }}",
  "system_context": {
    "factory_status": "{{ if eq .GroupLabels.service "factory-core" }}DEGRADED{{ else }}OPERATIONAL{{ end }}",
    "agent_coordination": "{{ if eq .GroupLabels.service "factory-core" }}AT_RISK{{ else }}OPERATIONAL{{ end }}",
    "project_generation": "{{ if or (eq .GroupLabels.service "factory-core") (eq .GroupLabels.service "domain-agents") }}AT_RISK{{ else }}OPERATIONAL{{ end }}"
  },
  "firing_alerts": [
    {{ range $i, $alert := .Alerts }}{{ if $i }},{{ end }}
    {
      "alertname": "{{ $alert.Labels.alertname }}",
      "summary": "{{ $alert.Annotations.summary }}",
      "description": "{{ $alert.Annotations.description }}",
      "service": "{{ $alert.Labels.service | default $alert.Labels.job }}",
      "severity": "{{ $alert.Labels.severity }}",
      "started_at": "{{ $alert.StartsAt.Format "2006-01-02T15:04:05Z" }}",
      "business_impact_score": "{{ if eq $alert.Labels.severity "critical" }}HIGH{{ else if eq $alert.Labels.severity "warning" }}MEDIUM{{ else }}LOW{{ end }}",
      "labels": {
        {{ range $key, $value := $alert.Labels }}{{ if ne $key "alertname" }}"{{ $key }}": "{{ $value }}",{{ end }}{{ end }}
        "dummy": "dummy"
      }
    }{{ end }}
  ]
}
{{ end }}

