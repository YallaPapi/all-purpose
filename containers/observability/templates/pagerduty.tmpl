{{ define "pagerduty.default.description" }}
{{ .GroupLabels.alertname }}: {{ .CommonAnnotations.summary }}
{{ end }}

{{ define "pagerduty.default.incident_key" }}
{{ .GroupLabels.alertname }}-{{ .GroupLabels.service | default .GroupLabels.job }}-{{ .GroupLabels.instance | default "unknown" }}
{{ end }}

{{ define "pagerduty.default.client" }}
Meta-Agent Factory Alertmanager
{{ end }}

{{ define "pagerduty.default.client_url" }}
http://localhost:9093
{{ end }}

{{ define "pagerduty.default.details" }}
{
  "alert_summary": "{{ .CommonAnnotations.summary }}",
  "alert_description": "{{ .CommonAnnotations.description }}",
  "service": "{{ .GroupLabels.service | default .GroupLabels.job }}",
  "severity": "{{ .GroupLabels.severity }}",
  "environment": "{{ .GroupLabels.environment | default "production" }}",
  "team": "{{ .GroupLabels.team | default "platform" }}",
  {{ if .GroupLabels.agent_type }}"agent_type": "{{ .GroupLabels.agent_type }}",{{ end }}
  {{ if .GroupLabels.instance }}"instance": "{{ .GroupLabels.instance }}",{{ end }}
  "alert_count": {{ len .Alerts }},
  "started_at": "{{ (index .Alerts 0).StartsAt.Format "2006-01-02T15:04:05Z" }}",
  "alertmanager_url": "http://localhost:9093",
  "dashboard_url": "http://localhost:3004/d/meta-agent-overview",
  "logs_url": "http://localhost:3004/explore?left=%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22expr%22%3A%22%7Bservice%3D%5C%22{{ .GroupLabels.service }}%5C%22%7D%22%7D%5D%7D",
  {{ if .CommonAnnotations.runbook_url }}"runbook_url": "{{ .CommonAnnotations.runbook_url }}",{{ end }}
  "generator_url": "{{ (index .Alerts 0).GeneratorURL }}",
  "firing_alerts": [
    {{ range $i, $alert := .Alerts }}{{ if $i }},{{ end }}
    {
      "alertname": "{{ $alert.Labels.alertname }}",
      "summary": "{{ $alert.Annotations.summary }}",
      "description": "{{ $alert.Annotations.description }}",
      "service": "{{ $alert.Labels.service | default $alert.Labels.job }}",
      "severity": "{{ $alert.Labels.severity }}",
      "started_at": "{{ $alert.StartsAt.Format "2006-01-02T15:04:05Z" }}",
      "labels": {
        {{ range $key, $value := $alert.Labels }}{{ if ne $key "alertname" }}"{{ $key }}": "{{ $value }}",{{ end }}{{ end }}
        "dummy": "dummy"
      }
    }{{ end }}
  ]
}
{{ end }}

