{
  "name": "prd-parser-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "PRD-Parser & Research Agent - Automatically parses PRD specifications and generates research-backed TaskMaster task lists",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "NODE_ENV=development node main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix"
  },
  "keywords": [
    "prd",
    "parser",
    "agent",
    "taskmaster",
    "research",
    "automation",
    "meta-agent",
    "agent-driven-development"
  ],
  "author": "PRD-Parser Agent <noreply@meta-agent-factory.dev>",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "prd-parser": "./main.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YallaPapi/all-purpose"
  },
  "bugs": {
    "url": "https://github.com/YallaPapi/all-purpose/issues"
  },
  "homepage": "https://github.com/YallaPapi/all-purpose#readme",
  "config": {
    "watchDir": "docs",
    "outputDir": ".taskmaster/tasks",
    "gitEnabled": true,
    "researchEnabled": true,
    "contextEnabled": true
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!main.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  }
}
