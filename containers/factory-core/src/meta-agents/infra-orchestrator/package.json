{
  "name": "infra-orchestrator-agent",
  "version": "1.0.0",
  "description": "Infrastructure Orchestrator Agent - Meta-Agent Factory oversight and compliance enforcement",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "validate": "npm run lint && npm run test",
    "orchestrate": "npm run build && node dist/main.js orchestrate",
    "audit": "npm run build && node dist/main.js audit",
    "compliance": "npm run build && node dist/main.js compliance"
  },
  "keywords": [
    "infrastructure",
    "orchestrator",
    "meta-agent",
    "compliance",
    "automation",
    "all-purpose-pattern"
  ],
  "author": "All-Purpose Meta-Agent Factory",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.3.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "joi": "^17.11.0",
    "mermaid": "^10.6.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/babel__parser": "^7.1.1",
    "@types/babel__traverse": "^7.20.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
