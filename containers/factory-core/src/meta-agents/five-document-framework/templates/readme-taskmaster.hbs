      "research_notes": "Standard setup patterns identified"
    }
  ]
}
```

### Complexity Analysis
```bash
# Analyze project complexity
task-master analyze-complexity --research

# Analyze specific tasks
task-master analyze-complexity --tasks="T001,T002,T003" --research

# Get complexity breakdown
task-master analyze-complexity --breakdown --research --output=complexity-report.json
```

### Task Expansion
```bash
# Expand all tasks with research
task-master expand --all --research

# Expand specific task
task-master expand --id="T001" --research --depth=detailed

# Interactive expansion mode
task-master expand --interactive --research
```

### Research Integration
```bash
# Research specific topic
task-master research "{{project.type}} best practices" --save

# Research technology integration
task-master research "{{#if project.technologies.frontend}}{{joinArray project.technologies.frontend}} {{/if}}integration patterns" --depth=comprehensive

# Research with project context
task-master research "debugging {{project.type}} applications" --context="{{project.name}}" --save
```

