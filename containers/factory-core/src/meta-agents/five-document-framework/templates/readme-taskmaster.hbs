## 🚀 **TaskMaster Setup**

### Installation & Configuration
```bash
# Install TaskMaster CLI
npm install -g taskmaster-cli

# Verify installation
task-master --version

# Initialize in project
cd {{project.name}}
task-master init
```

### Environment Configuration
```bash
# Required environment variables
export ANTHROPIC_API_KEY="your_claude_api_key"
export PERPLEXITY_API_KEY="your_perplexity_api_key"

# Optional: Enhanced integrations
export GITHUB_TOKEN="your_github_token"
export OPENAI_API_KEY="your_openai_api_key"
```

### Project Configuration (.taskmaster.json)
```json
{
  "project": {
    "name": "{{project.name}}",
    "version": "{{project.version}}",
    "type": "{{project.type}}",
    "technologies": [{{#if computed.technologyList}}"{{joinArray computed.technologyList "\", \""}}"{{/if}}]
  },
  "settings": {
    "research_enabled": true,
    "complexity_analysis": true,
    "auto_expand": true,
    "max_tasks": {{#if generation.maxTasks}}{{generation.maxTasks}}{{else}}100{{/if}},
    "research_depth": "comprehensive"
  },
  "integrations": {
    {{#if generation.integrateWithGit}}
    "git": {
      "enabled": true,
      "auto_commit": false,
      "branch_strategy": "feature"
    },
    {{/if}}
    "documentation": {
      "enabled": true,
      "auto_update": true,
      "formats": ["markdown", "json"]
    }
  },
  "templates": {
    "task_format": "all-purpose-pattern",
    "research_template": "comprehensive",
    "output_format": "detailed"
  }
}
```

