# Simplified Factory Core Dockerfile - ZAD Mandate Compliance
# This builds only the simple factory core without complex meta-agents

FROM node:20-alpine AS base

WORKDIR /app

# Install TypeScript and tsx for building
RUN npm install -g typescript tsx

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy only the simple factory core and minimal dependencies
COPY src/simple-factory-core.ts ./src/
COPY tsconfig.json ./

# Create a minimal tsconfig for just the simple factory core
RUN echo '{\
  "compilerOptions": {\
    "target": "ES2022",\
    "module": "NodeNext",\
    "moduleResolution": "NodeNext",\
    "outDir": "./dist",\
    "rootDir": "./src",\
    "strict": true,\
    "esModuleInterop": true,\
    "skipLibCheck": true,\
    "forceConsistentCasingInFileNames": true\
  },\
  "include": ["src/simple-factory-core.ts"]\
}' > tsconfig.simple.json

# Build the simple factory core
RUN npx tsc --project tsconfig.simple.json

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Copy package files and install production dependencies
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Install curl for health check
RUN apk add --no-cache curl

# Copy the compiled simple factory core
COPY --from=base /app/dist ./dist

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S factory -u 1001 -G nodejs

# Set ownership and switch to non-root user
RUN chown -R factory:nodejs /app
USER factory

EXPOSE 3005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3005/health || exit 1

# Environment variables
ENV NODE_ENV=production
ENV PORT=3005
ENV NATS_URL=nats://nats:4222

# Start the simple factory core
CMD ["node", "dist/simple-factory-core.js"]