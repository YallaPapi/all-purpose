{
  "documentation": {
    "enabled": true,
    "name": "Documentation",
    "description": "Intelligent documentation agent with API doc generation, technical writing, knowledge base management, and content optimization capabilities",
    "version": "1.0.0",
    "logLevel": "info",
    "timeout": 30000,
    "retries": 3,
    "retryDelay": 1000
  },
  "environment": {
    "nodeEnv": "development",
    "debugMode": false,
    "verboseLogging": false
  },
  "performance": {
    "maxConcurrency": 10,
    "batchSize": 100,
    "memoryLimit": "512MB"
  },
  "monitoring": {
    "enableMetrics": true,
    "metricsInterval": 60000,
    "enableHealthCheck": true,
    "healthCheckPort": 3001
  },
  "tasks": {
    "defaultPriority": "medium",
    "maxTasksPerRun": 1000,
    "taskTimeout": 300000
  }
}