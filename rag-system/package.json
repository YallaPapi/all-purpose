{
  "name": "all-purpose-rag-system",
  "version": "1.0.0",
  "description": "RAG Documentation Memory System for All-Purpose Project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f qdrant"
  },
  "keywords": [
    "rag",
    "vector-database",
    "qdrant",
    "documentation",
    "memory",
    "embeddings"
  ],
  "author": "All-Purpose Project",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.8.2",
    "@upstash/vector": "^1.2.2",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.3",
    "joi": "^17.11.0",
    "node-cron": "^3.0.3",
    "openai": "^4.28.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.17",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
